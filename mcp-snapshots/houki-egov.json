{
  "$comment": "自動生成（scripts/update-mcp-snapshots.mjs）。手で編集しないでください",
  "server": "houki-egov",
  "npm": "@shuji-bonji/houki-egov-mcp",
  "version": "0.15.2",
  "tools": [
    {
      "name": "explain_law_type",
      "properties": [
        "name"
      ],
      "required": [
        "name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_article_references",
      "properties": [
        "article",
        "at",
        "law_name",
        "paragraph"
      ],
      "required": [
        "article",
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_attachment",
      "properties": [
        "at",
        "law_name",
        "save",
        "src"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_law",
      "properties": [
        "article",
        "at",
        "format",
        "item",
        "law_name",
        "paragraph"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_law_file",
      "properties": [
        "at",
        "file_type",
        "law_name",
        "save"
      ],
      "required": [
        "file_type",
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_law_range",
      "properties": [
        "at",
        "chapter",
        "division",
        "from_article",
        "law_name",
        "max_chars",
        "part",
        "path",
        "section",
        "subsection",
        "suppl_index"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_law_revisions",
      "properties": [
        "latest",
        "law_name"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_related_laws",
      "properties": [
        "law_name"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "get_toc",
      "properties": [
        "at",
        "depth",
        "law_name",
        "suppl",
        "with_amend_titles"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "list_attachments",
      "properties": [
        "at",
        "law_name"
      ],
      "required": [
        "law_name"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "resolve_abbreviation",
      "properties": [
        "abbr"
      ],
      "required": [
        "abbr"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "search_fulltext",
      "properties": [
        "domain",
        "keyword",
        "law_type",
        "limit",
        "scan_body"
      ],
      "required": [
        "keyword"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "search_law",
      "properties": [
        "domain",
        "keyword",
        "law_type",
        "limit"
      ],
      "required": [
        "keyword"
      ],
      "acceptsUnknownArgs": false
    },
    {
      "name": "verify_citations",
      "properties": [
        "at",
        "citations"
      ],
      "required": [
        "citations"
      ],
      "acceptsUnknownArgs": false
    }
  ],
  "errorCodesSource": "https://github.com/shuji-bonji/houki-egov-mcp/blob/v0.15.2/specs/current/common_errors/spec.md",
  "errorCodes": [
    "ARTICLE_NOT_FOUND",
    "ATTACHMENT_NOT_FOUND",
    "INTERNAL_ERROR",
    "INVALID_ARGUMENT",
    "INVALID_ARTICLE_NUM",
    "LAW_NOT_FOUND",
    "OUT_OF_SCOPE",
    "RANGE_NOT_FOUND",
    "SOURCE_API_ERROR",
    "SOURCE_RATE_LIMITED",
    "SOURCE_TIMEOUT",
    "SOURCE_UNAVAILABLE",
    "UNKNOWN_TOOL"
  ]
}
